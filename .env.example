# Firebase Configuration (Client-side)
# Get these from Firebase Console: https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK (Server-side only - for duplicate detection)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
# Optional: If not set, duplicate detection will be disabled
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Backblaze B2 Configuration (Server-side only - credentials never exposed to browser)
# Get these from Backblaze B2 Console: https://www.backblaze.com/b2/cloud-storage.html
# 1. Create a bucket (can be private - no need to pay for public)
# 2. Create an application key with read/write access to the bucket
# 3. Copy keyID and applicationKey (shown only once!)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_ID=your-bucket-id
B2_ACCESS_KEY_ID=your-key-id
B2_SECRET_ACCESS_KEY=your-application-key
B2_BUCKET_NAME=your-bucket-name
